#!/bin/sh
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
    check)
        printf '%s\n' 'ha-pi-power-ready'
        ;;
    poweroff|reboot)
        exec /usr/bin/sudo -n /usr/bin/systemctl --no-block "$SSH_ORIGINAL_COMMAND"
        ;;
    *)
        printf '%s\n' 'Command not permitted' >&2
        exit 126
        ;;
esac
